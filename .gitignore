# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
.venv/
venv/
env/
ENV/

# Distribution / packaging build outputs
build/
dist/
*.egg-info/
.eggs/

# Installer output binaries (generated by CI/CD or local build scripts)
*.dmg
*.exe
!portal/downloads/*.dmg
!portal/downloads/*.exe
!portal/downloads/*.tar.gz

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Streamlit secrets
.streamlit/secrets.toml
